# Database (PostgreSQL)
DATABASE_URL="postgresql://pulsetrace:pulsetrace_secret@localhost:5432/pulsetrace_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API Server
PORT=4000
HOST="0.0.0.0"
JWT_SECRET="super-secret-jwt-key-pulsetrace-2026-change-in-prod"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Web App
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000/ws"

# Worker
WORKER_CONCURRENCY=5
BATCH_SIZE=100
BATCH_TIMEOUT_MS=1000
